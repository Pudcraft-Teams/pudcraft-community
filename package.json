{
  "name": "pudcraft-community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "sh -c 'set -a; . ./.env.example; set +a; node --import tsx --test $(find src prisma scripts -type f \\( -name \"*.test.ts\" -o -name \"*.test.tsx\" -o -name \"*.spec.ts\" -o -name \"*.spec.tsx\" \\) 2>/dev/null | sort)'",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "sync:favorite-counts": "tsx scripts/sync-favorite-counts.ts",
    "sync:favorite-count": "tsx prisma/sync-favorite-count.ts",
    "migrate:uploads": "tsx scripts/migrate-uploads-to-oss.ts",
    "migrate:uploads:dry": "tsx scripts/migrate-uploads-to-oss.ts --dry-run",
    "storage:check": "tsx scripts/verify-storage-behavior.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "ws": "tsx src/ws/index.ts",
    "ws:dev": "tsx watch src/ws/index.ts",
    "build:worker": "node -e \"require('esbuild').buildSync({entryPoints:['src/worker/index.ts'],bundle:true,platform:'node',target:'node24',outfile:'dist/worker.js',tsconfig:'tsconfig.json',external:['@prisma/client']})\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@alicloud/green20220302": "3.2.3",
    "@alicloud/openapi-core": "^1.0.7",
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@darabonba/typescript": "^1.0.4",
    "@prisma/client": "^6.19.2",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-underline": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "bullmq": "^5.74.1",
    "cropperjs": "^1.6.2",
    "date-fns": "^4.1.0",
    "graceful-fs": "^4.2.11",
    "ioredis": "^5.10.1",
    "markdown-it": "^14.1.1",
    "minecraft-server-util": "^5.4.4",
    "next": "^16.2.4",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.9.1",
    "react": "^19.2.5",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.34.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "ws": "^8.20.0",
    "yauzl": "^3.3.0",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/cropperjs": "^1.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
